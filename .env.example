# Copy to .env and fill in RIT_API_KEY.   cp .env.example .env
# .env is gitignored - never commit your real key.

# From the RIT client: click the "API" icon on the bottom bar and copy the key.
# The "API Orders" icon must be GREEN to send orders (it is server-controlled).
RIT_API_KEY=

# The REST API is served by the RIT client on YOUR machine. Defaults are right.
RIT_HOST=localhost
RIT_PORT=9999
# RIT_URL=http://localhost:9999/v1      # overrides host/port when set

# true = log decisions, send nothing. `run --live` overrides this.
RIT_DRY_RUN=true

# Seconds between loops (per-case value in config/<case>.toml wins).
RIT_INTERVAL=0.25
# Minimum seconds between API calls. Raise to 0.1-0.2 if you see HTTP 429.
RIT_MIN_INTERVAL=0.0
