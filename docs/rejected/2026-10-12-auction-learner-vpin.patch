+
+
+def test_reserve_model_learns_from_censored_bids():
+    # Wins at 0.30 say the reserve is at least that far through the mid; losses at 0.10 say it is closer.
+    generous = ReserveModel(obs="0.30:1;0.35:1;0.25:1")
+    stingy = ReserveModel(obs="0.10:0;0.08:0;0.12:0")
+    assert generous.mean() > 0.3 > stingy.mean()
+    assert generous.survival(0.2) > 0.8 > 0.2 > stingy.survival(0.2)
+    assert parse_obs([[0.2, 1]]) == [(0.2, True)] and parse_obs("") == []
+
