+def test_toxic_flow_against_our_unwind():
+    from ritc.core.bot import Context, Snapshot
+    from ritc.core.risk import RiskManager
+    from ritc.strategies.liability import LiabilityStrategy
+
+    cfg = {"case": {"tickers": ["X"]}, "strategy": {"toxic_cross": True, "vpin_bucket": 1000, "vpin_n": 4,
+                                                    "toxic_threshold": 0.4}}
+    s = LiabilityStrategy(Context(None, Executor(None), RiskManager(), cfg))
+    s.algo.work("X", 50_000, 0, 0, 60)                     # long 50k: we sell, we need buyers
+    snap = Snapshot({"tick": 10, "period": 1, "ticks_per_period": 420}, {"X": {"position": 50_000}})
+    for _ in range(4):
+        s._add_volume("X", 900, 100)                       # buyers dominate: our side fills
+    assert s.toxic_tickers(snap) == set()
+    for _ in range(4):
+        s._add_volume("X", 100, 900)                       # sellers dominate: our resting sells starve
+    assert s.toxic_tickers(snap) == {"X"}
+    s.algo.crossed[("X", "SELL")] = 5000                   # our own crossing prints as selling: not counted
+    s._add_volume("X", 600, 5400)
+    assert s.vbuckets["X"][-1] == (600, 400)
+
