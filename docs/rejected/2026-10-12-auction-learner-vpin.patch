+def test_plan_children_urgent_crosses_everything_left_within_the_book():
+    book = OrderBook("X", [Level(9.99, 20_000), Level(9.98, 20_000)], [Level(10.01, 20_000), Level(10.02, 20_000)])
+    calm = plan_children(book, 50_000, 50_000, 0, 100, 25_000, AlgoParams())
+    assert not [c for c in calm if not c.passive]          # on schedule: rest only
+    hot = plan_children(book, 50_000, 50_000, 0, 100, 25_000, AlgoParams(), urgent=True)
+    assert [c for c in hot if not c.passive and c.action == "SELL"]
+    held = plan_children(book, 50_000, 50_000, 0, 100, 25_000, AlgoParams(), passive_only=True, urgent=True)
+    assert not [c for c in held if not c.passive]          # hold-to-the-bell window wins over toxic flow
