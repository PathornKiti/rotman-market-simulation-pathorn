+"""
+Learning the hidden auction reserve from our own bids, and the bid that maximises expected profit.
+
+A competitive auction fills any bid past a hidden reserve. Measure everything from the mid at the bid, in OUR
+favour: our bid sits `d` $/share from the mid (bid = mid - d when we buy), the reserve `R` from the mid the same
+way. We win iff R >= d, so every bid is a CENSORED observation of R: a win says R >= d, a loss says R < d. (In a
+winner-take-all the rivals' best bid acts like a second reserve; the same curve "P(win | d)" then covers both.)
+
+Model: R ~ Normal(mu, s), with a grid posterior over (mu, s), a normal prior on mu and a flat one on s. Each
+observation multiplies in its censored likelihood, P(R >= d) = 1 - Phi((d - mu) / s) for a win, Phi(...) for a
+loss (Turnbull-style interval censoring, parametric so a handful of bids is enough).
+
+Bid: with break-even distance c (exit, fees, risk: what the block is worth to us, measured from the mid) and a
+cost of the net-limit room the block uses, expected profit per share at distance d is
+
+    pi(d) = P(R >= d) x (d - c - room_cost)
+
+maximised over d (first-order condition d* = c + room + (1 - F(d*)) / f(d*), the inverse hazard rate of optimal
+auction / monopsony pricing). P(R >= d) is the posterior-predictive survival, so uncertainty widens the curve.
+"""
+
+from __future__ import annotations
+
+import math
+
+MU_GRID = [round(-0.30 + 0.025 * i, 4) for i in range(53)]          # -0.30 .. 1.00 $/share through the mid
+SD_GRID = [0.03, 0.05, 0.08, 0.12, 0.18, 0.25, 0.35]
+
+
+def _phi(x: float) -> float:
+    return 0.5 * (1.0 + math.erf(x / math.sqrt(2.0)))
+
+
+def parse_obs(spec) -> list[tuple[float, bool]]:
+    """Observations as [[d, won], ...] or the grid-friendly string "0.24:0;0.18:1" (d $/share : won 0/1)."""
+    if not spec:
+        return []
+    if isinstance(spec, str):
+        out = []
+        for part in filter(None, (p.strip() for p in spec.split(";"))):
+            d, _, w = part.partition(":")
+            out.append((float(d), bool(int(float(w)))))
+        return out
+    return [(float(d), bool(w)) for d, w in spec]
+
+
+class ReserveModel:
+    """Grid posterior over the reserve distance R ~ Normal(mu, s) from censored win / loss observations."""
+
+    def __init__(self, prior_mu: float = 0.15, prior_mu_sd: float = 0.30, obs=None):
+        self.cells = [(m, s) for m in MU_GRID for s in SD_GRID]
+        self.logp = [-0.5 * ((m - prior_mu) / prior_mu_sd) ** 2 for m, _ in self.cells]
+        self.n = 0
+        self.wins = 0
+        for d, won in parse_obs(obs):
+            self.update(d, won)
+
+    def update(self, d: float, won: bool) -> None:
+        for i, (m, s) in enumerate(self.cells):
+            p = 1.0 - _phi((d - m) / s) if won else _phi((d - m) / s)
+            self.logp[i] += math.log(max(p, 1e-12))
+        self.n += 1
+        self.wins += bool(won)
+
+    def _weights(self) -> list[float]:
+        top = max(self.logp)
+        w = [math.exp(x - top) for x in self.logp]
+        z = sum(w)
+        return [x / z for x in w]
+
+    def survival(self, d: float, w: list[float] | None = None) -> float:
+        """Posterior-predictive P(R >= d): the chance a bid `d` through the mid wins."""
+        w = w or self._weights()
+        return sum(wi * (1.0 - _phi((d - m) / s)) for wi, (m, s) in zip(w, self.cells) if wi > 1e-9)
+
+    def mean(self) -> float:
+        return sum(wi * m for wi, (m, _) in zip(self._weights(), self.cells))
+
+    def best_distance(self, c: float, room_cost: float = 0.0, min_margin: float = 0.01,
+                      span: float = 1.0, step: float = 0.01) -> tuple[float, float, float]:
+        """(d*, P(win at d*), expected $/share) maximising P(R >= d) (d - c - room_cost), d >= c + room + margin."""
+        w = self._weights()
+        lo = c + room_cost + min_margin
+        best = (lo, self.survival(lo, w), 0.0)
+        k = 0
+        while k * step <= span:
+            d = lo + k * step
+            p = self.survival(d, w)
+            ev = p * (d - c - room_cost)
+            if ev > best[2]:
+                best = (d, p, ev)
+            k += 1
+        return best
