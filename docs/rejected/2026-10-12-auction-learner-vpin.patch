+def test_best_bid_never_below_break_even_and_shades_by_the_learned_reserve():
+    generous = ReserveModel(obs="0.50:1;0.55:1;0.45:1;0.60:0")
+    d, p, ev = generous.best_distance(c=0.10, room_cost=0.05)
+    assert d >= 0.10 + 0.05 + 0.01 and ev > 0
+    assert d > 0.35                                         # the reserve is generous: keep most of the edge
+    stingy = ReserveModel(obs="0.10:0;0.05:0;0.15:0;0.02:1")
+    d2, p2, ev2 = stingy.best_distance(c=0.10)
+    assert d2 >= 0.11 and p2 < 0.2                         # can't win profitably: the bid stays at break-even+
